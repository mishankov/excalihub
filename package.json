{
  "name": "excalihub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "user:create": "node --env-file-if-exists=.env scripts/users.mjs create",
    "user:password": "node --env-file-if-exists=.env scripts/users.mjs password",
    "user:list": "node --env-file-if-exists=.env scripts/users.mjs list",
    "test": "node --test tests/*.test.mjs",
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "test:integration": "node --test tests/http.integration.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "format": "prettier --write src server scripts tests *.json *.ts *.js *.md *.yaml"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@lucide/svelte": "^1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
